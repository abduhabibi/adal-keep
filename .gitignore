# Dependencies
node_modules/

# Environment & Secrets
.env
.env.*
*.pem
*.key

# SQLite Database
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Build outputs
dist/
.vite/
.tauri/

# Rust/Tauri build artifacts (HUGE - never commit)
adal-portal/src-tauri/target/

# Uploaded files
adal-keep-backend/uploads/
adal-keep-backend/data/
adal-keep-backend/public/wallpaper.jpg
backend/uploads/
backend/public/

# Logs
*.log
adal-keep-backend/logs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Subscription lock file (local only)
.subscription_lock

# Backup files
backup_*/

# Misc
CACHEDIR.TAG

# Update marker written by the software updater
.adal-version.json

# Personal data and local backups: never commit these (any folder level)
**/uploads/
**/SafeStorage/
**/data/
**/backups/
*.sqlite.OLD-*
adal-keep-backend/data/

# Build output and local tooling (generated; never committed)
adal-installer/bundle/
Adal Keep Main/
.venv/
adal-keep-backend/.venv/
database.db

# USB build output (contains the .env keys)
Adal Keep USB/
adal-installer/stage/
adal-installer/.deps-keep/

# runtime logs
adal-keep-backend/logs/*.log
adal-launcher/AdalKeep.exe
adal-companion/adal-companion.exe

# Personal data / old copies — never publish
AdalKeep-Installer/
all_musaned_candidates.json
adal-keep-backend/samples/
adal-keep-backend/PASSPORT-DEBUG.txt
all-source.txt

# Seller page: carries the licence key
seller/*PRIVATE*
dist-demo/
adal-installer/tools/seticon.exe

# Per-PC licence state (trial start, unlock) — never shared
adal-keep-backend/.adal_sub.json

# This PC's chat account (made on first use) — never shared
adal-keep-backend/.adal_chat.json
adal-admin/.env

# admin panel log
adal-admin/admin.log
